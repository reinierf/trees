{
  "name": "bomen-fetcher",
  "version": "2.0.0",
  "description": "Fetch municipal tree datasets for Dutch cities",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "fetch": "node index.js --all",
    "add-city": "node add-city.js",
    "patch-binomials": "node patch-binomials.js",
    "validate-pipeline": "node tools/validate-pipeline.js",
    "validate-species": "node tools/validate-species.js",
    "fetch-vernacular-base": "node tools/vernacular/base/fetch.js",
    "build-vernacular-nl": "node tools/vernacular/nl/build.js",
    "merge-vernacular-nl": "node tools/vernacular/nl/merge.js",
    "fetch-vernacular-genera": "node tools/vernacular/base/fetch-genera.js",
    "build-db": "node tools/build-db.js"
  },
  "dependencies": {
    "sql.js": "^1.14.1",
    "xml2js": "^0.6.2"
  },
  "engines": {
    "node": ">=22.13"
  }
}
